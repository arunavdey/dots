general {
        colors = true
        interval = 5
}

order += "wireless wlan0"
order += "ethernet eno1"
order += "memory"
order += "volume master"
order += "tztime local"

wireless wlan0 {
        format_up = "W: (%quality at %essid, %bitrate) %ip"
        format_down = "W: down"
}

ethernet eno1 {
        format_up = "E: %ip (%speed)"
        format_down = "E: down"
}

memory {
        format = "MEM: %available"
}

volume master {
        format = "VOL: %volume"
        format_muted = "VOL: off"
}

disk / {
        format = "/: %avail"
}

disk /mnt/hdd {
        format = "/mnt/hdd: %avail"
}

tztime local {
        format = "%Y-%m-%d %H:%M:%S %Z"
}
